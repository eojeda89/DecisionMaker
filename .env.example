# Copia este archivo a `.env` (o exportá estas variables en tu shell) para
# levantar DecididorAPI localmente sin usar los valores por defecto del
# repo. Ninguna de estas variables es leída automáticamente de un .env por
# Spring Boot: si usás `./mvnw spring-boot:run` directo, exportalas en tu
# shell o pasalas como -D en la JVM. `docker-compose up` sí las inyecta
# (ver docker-compose.yml) para el servicio `app`.

# --- Servidor ---
# Puerto en el que escucha la app. Railway inyecta su propio PORT en
# producción; no hace falta setearlo en local salvo que quieras otro puerto.
PORT=8080

# --- Base de datos (PostgreSQL) ---
# DB_URL debe ser una URL JDBC completa (jdbc:postgresql://host:puerto/db),
# nunca el formato postgresql://user:pass@host/db que entregan algunos
# proveedores (Railway, Koyeb) — el driver lo rechaza si se pega directo acá.
DB_URL=jdbc:postgresql://localhost:5432/decididor
DB_USERNAME=ideadbowner
DB_PASSWORD=ideadbowner

# --- JWT ---
# Sin esta variable, JwtService cae en el default "dev-secret-change" —
# válido solo para desarrollo local. En cualquier entorno público (Railway,
# etc.) hay que setear un secreto largo y aleatorio (32+ bytes).
# Generar uno: openssl rand -base64 64
security.jwt.secret=dev-secret-change
# Duración del token en milisegundos (default: 1 hora)
security.jwt.expiration-ms=3600000

# --- CORS ---
# Orígenes permitidos para consumir /api/** desde un navegador, separados
# por coma. "*" por default (la API usa Bearer tokens, no cookies, así que
# un origen abierto no compromete credenciales). Restringir si hace falta:
# app.cors.allowed-origins=https://mi-frontend.com,https://otro.com
app.cors.allowed-origins=*
